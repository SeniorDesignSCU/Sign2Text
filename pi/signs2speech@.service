# Boot-to-app service. The part after @ is your Pi username:
#   sudo cp pi/signs2speech@.service /etc/systemd/system/
#   sudo systemctl enable --now signs2speech@$USER
[Unit]
Description=Signs to Speech ASL recognizer (user %i)
After=sound.target

[Service]
User=%i
SupplementaryGroups=video audio
WorkingDirectory=/home/%i/Sign2Text
ExecStart=/home/%i/Sign2Text/.venv/bin/python pi/run.py --headless
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
